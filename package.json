{
  "name": "mapart-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "powershell -NoProfile -Command \"if (Test-Path node_modules) { Remove-Item -Recurse -Force node_modules }; if (Test-Path package-lock.json) { Remove-Item -Force package-lock.json }; if (Test-Path auth-cache) { Remove-Item -Recurse -Force auth-cache }; New-Item -ItemType Directory -Path auth-cache -Force | Out-Null\"",
    "clean:install": "npm run clean && npm install",
    "start": "node index.js",
    "start:nerv": "node nerv-printer.js",
    "start:nerv:wait": "node nerv-printer.js --wait-for-command",
    "start:nerv:premium-1": "node nerv-printer.js --config=nerv-printer-config/_configs/nerv-printer-config-premium-1.json",
    "start:nerv:local": "node nerv-printer.js --connection=local",
    "start:nerv:local:wait": "node nerv-printer.js --connection=local --wait-for-command",
    "start:nerv:6b6t": "node nerv-printer.js --connection=6b6t",
    "start:nerv:6b6t:wait": "node nerv-printer.js --connection=6b6t --wait-for-command",
    "test:dump": "node nerv-printer.js --test-dump",
    "test:moving-place": "node nerv-printer.js --test-moving-place",
    "test:nerv-scanner": "node nerv-printer.js --test-nerv-scanner",
    "test:nerv-workload": "node nerv-printer.js --test-nerv-workload",
    "test:inventory-plan": "node nerv-printer.js --test-inventory-plan",
    "test:inventory-cycle": "node nerv-printer.js --test-inventory-cycle",
    "test:inventory-2rows": "node nerv-printer.js --test-inventory-cycle --inventory-rows=2",
    "test:repair": "node nerv-printer.js --test-repair",
    "test:post-print": "node nerv-printer.js --test-post-print",
    "test:post-print:full": "node nerv-printer.js --test-post-print-full",
    "test:post-print:full:6b6t": "node nerv-printer.js --connection=6b6t --test-post-print-full",
    "test:multi-user-plan": "node nerv-printer.js --test-multi-user-plan",
    "test:6b6t-lobby": "node nerv-printer.js --connection=6b6t --test-6b6t-lobby",
    "test:6b6t-portal": "node nerv-printer.js --connection=6b6t --test-6b6t-portal",
    "test:spatial-portal": "node nerv-printer.js --connection=6b6t --test-spatial-portal",
    "test:spatial": "node nerv-printer.js --connection=6b6t --test-spatial",
    "test:move5": "node src/nerv-printer/diagnostics/move-test.js",
    "test:dashboard-queue": "npm --prefix dashboard-service test",
    "nixtri:nodes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nixtri-nodes.ps1",
    "nixtri:dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nixtri-dashboard.ps1",
    "start:broadcast": "set ENABLE_QUOTE_BROADCAST=true&& node index.js",
    "graphify:build": "npm run graphify:refresh",
    "graphify:update": "npm run graphify:refresh",
    "graphify:watch": "node scripts/run-graphify.js watch .",
    "graphify:context": "node scripts/graphify-augment.js",
    "graphify:cluster": "node scripts/run-graphify.js cluster-only .",
    "graphify:refresh": "node scripts/run-graphify.js update . && node scripts/graphify-augment.js && node scripts/run-graphify.js cluster-only .",
    "graphify:report": "powershell -NoProfile -Command \"Get-Content graphify-out/GRAPH_REPORT.md\"",
    "graphify:codex-install": "node scripts/run-graphify.js codex install",
    "graphify:claude-install": "node scripts/run-graphify.js claude install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "mineflayer": "^4.37.0",
    "mineflayer-pathfinder": "^2.4.5"
  }
}
